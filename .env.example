# Copier en .env (non versionné) et renseigner. Utilisé par docker compose.

# Clé de chiffrement des Secret Keys S3 en base — à générer une fois, à garder stable.
APP_MASTER_KEY=change-me
# Signature des sessions Flask (par défaut : réutilise APP_MASTER_KEY).
FLASK_SECRET_KEY=change-me-too
# Premier compte admin, créé si la base est vide.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-again

# Mise à jour depuis Administration → Version, en déploiement conteneur.
# Jeton partagé entre l'app et le sidecar `updater`. Laisser vide pour désactiver
# le bouton (mise à jour manuelle : docker compose -f docker-compose.yml pull && up -d).
#   openssl rand -hex 32
UPDATE_TOKEN=
